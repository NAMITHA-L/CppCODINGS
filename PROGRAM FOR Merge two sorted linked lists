def sortedMerge(head1, head2):
  
    # Base cases
    if head1 is None:
        return head2
    if head2 is None:
        return head1

    # Recursive merging based on smaller value
    if head1.data <= head2.data:
        head1.next = sortedMerge(head1.next, head2)
        return head1
    else:
        head2.next = sortedMerge(head1, head2.next)
        return head2

def printList(curr):
    while curr is not None:
        print(curr.data, end=" ")
        curr = curr.next
    print()
